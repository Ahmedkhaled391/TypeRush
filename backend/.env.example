NODE_ENV=production

# Server
PORT=5001

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/typerush

# CORS — frontend origin (no trailing slash)
CLIENT_URL=https://your-frontend-domain.com

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_random_hex
JWT_REFRESH_SECRET=replace_with_different_64_byte_random_hex
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

